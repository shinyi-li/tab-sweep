{
  "manifest_version": 3,
  "name": "Tab Sweep",
  "version": "0.1.0",
  "description": "Find duplicate tabs and close them with one click.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "action": {
    "default_title": "Tab Sweep",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
